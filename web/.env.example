# VladLaunch — environment
#
# There is deliberately NO private key here. Launches are signed by the visitor's own
# wallet in the browser. A key in a Vercel environment variable would sign for whoever
# loaded the page, and would be one misconfigured preview deployment away from public.

# The CustomFeeStrategy this site launches through. Its address is the launchpad's
# registry: every token launched via it emits TokenLaunched from this address, so
#   eth_getLogs({ address: <this>, topics: [TokenLaunched] })
# returns exactly the VladLaunch catalogue and nothing else.
#
# Deploy a FRESH strategy before going live so the log history starts clean, then never
# change it — switching splits the catalogue across two addresses.
NEXT_PUBLIC_STRATEGY=0x544ef36801e90ee56bcd699ed51a63cfceac8ec9

# Pinata — server-side only. NEVER prefix the JWT with NEXT_PUBLIC_.
PINATA_JWT=
NEXT_PUBLIC_PINATA_GATEWAY=cyan-cheerful-fish-957.mypinata.cloud

# VladFeeSplit — holds every LP position and pays out 75/25.
NEXT_PUBLIC_FEE_SPLIT=

# VladLaunchRouter — needed for the atomic opening buy.
NEXT_PUBLIC_ROUTER=

# Treasury that receives the protocol 25%. Must match what Deploy.s.sol was given.
NEXT_PUBLIC_TREASURY=0x5Fa157B3E446A71e57b8d1642cd2E5693dF4af32
